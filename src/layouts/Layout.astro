                        <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.4v2.1M12 19.5v2.1M4.2 4.2l1.5 1.5M18.3 18.3l1.5 1.5M2.4 12h2.1M19.5 12h2.1M4.2 19.8l1.5-1.5M18.3 5.7l1.5-1.5"/></svg>
                    </button>
                    <button class="erp-hamburger" id="hamburgerBtn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
                        <span></span><span></span><span></span>
                    </button>
                    <a href={navSignupHref} class="btn btn-primary btn-pill erp-nav-cta-btn" data-track="trial_start" data-track-where="nav">Start Free Trial</a>
                </div>
            </div>
        </header>

        <!-- Mobile Nav Drawer -->
        <div class="erp-mobile-nav" id="mobileNav" aria-hidden="true">
            <div class="erp-mobile-nav-inner">
                <nav aria-label="Mobile">
                    <a href="#erp-pains">Why</a>
                    <a href="#erp-features">Features</a>
                    <a href="#erp-showcase">See It</a>
                    <a href="#erp-pricing">Pricing</a>
                </nav>
                <div class="erp-mobile-nav-cta">
                    <a href={drawerSignupHref} class="btn btn-primary btn-pill w-100" data-track="trial_start" data-track-where="mobile-nav">Start Free Trial</a>
                    <a href="#erp-contact" class="btn btn-ghost btn-pill w-100 erp-mobile-nav-cta-alt" data-track="plan_select" data-track-where="mobile-nav">Talk to Us First</a>
                </div>
            </div>
        </div>

		<main id="erp-main">
			<slot />
		</main>

        <!-- WhatsApp is the primary sales channel for this market, so it needs
             a persistent affordance rather than only appearing once the
             visitor has scrolled all the way to the contact section. -->
        <a
            href={whatsappLink}
            class="erp-whatsapp-fab"
            data-track="whatsapp_click"
            data-track-where="fab"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Chat with QuadERP on WhatsApp"
        >
            <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span class="erp-whatsapp-fab-label">Chat with us</span>
        </a>

        <!-- Footer -->
        <footer class="erp-footer">
