                        is set it also sets analytics cookies. Neither is
                        defensible with no route to the policy from the page
                        doing the collecting. Both pages already exist on the
                        app, so this links rather than duplicates them. */}
                    <nav class="erp-footer-legal" aria-label="Legal">
                        <a href="https://app.quaderp.app/privacy">Privacy</a>
                        <a href="https://app.quaderp.app/terms">Terms</a>
                    </nav>
                </div>
            </div>
        </footer>

        <script>
            /* Carry the campaign across to the app.

               app.quaderp.app is a separate origin, so it shares no cookie, no
               storage and no analytics session with this page. The href itself
               is the only channel. Build time already put `cta` and `lp` on
               these links; this adds the part that is only knowable at runtime.

               Done on load rather than in a click handler so that a middle
               click, a ctrl-click and "copy link address" all keep it. */
            const CAMPAIGN_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
            const carry: Record<string, string> = {};

            for (const key of CAMPAIGN_KEYS) {
                const value = new URL(window.location.href).searchParams.get(key);
                if (value) carry[key] = value.slice(0, 120);
            }

            /* No campaign tags, so fall back to who sent them. Hostname only:
               a full referrer URL can carry someone's search terms or a path
               that identifies them, and none of that belongs in our database. */
            if (Object.keys(carry).length === 0 && document.referrer) {
                try {
                    const host = new URL(document.referrer).hostname;
                    if (host && host !== window.location.hostname) {
                        carry.ref = host.replace(/[^a-zA-Z0-9.-]/g, '').slice(0, 40);
                    }
                } catch {
                    /* A referrer we cannot parse is not worth a broken page. */
                }
            }

            if (Object.keys(carry).length > 0) {
                /* Signup and the sandbox only. The footer's Privacy and Terms
                   links point at the same origin and tagging those would put
                   campaign parameters on a legal page for no reason. */
                const selector = 'a[href^="https://app.quaderp.app/signup"], a[href^="https://app.quaderp.app/login"]';
                document.querySelectorAll<HTMLAnchorElement>(selector).forEach((link) => {
                    const url = new URL(link.href);
                    for (const [key, value] of Object.entries(carry)) {
                        /* Never overwrite: an explicit value in the markup is
                           deliberate and outranks anything inferred here. */
                        if (!url.searchParams.has(key)) url.searchParams.set(key, value);
                    }
                    link.href = url.href;
                });
            }

            // Scroll-reveal
            const observer = new IntersectionObserver((entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                        observer.unobserve(entry.target);
                    }
                }
            }, { threshold: 0.12, rootMargin: '0px 0px -48px 0px' });

            document.querySelectorAll('.animate-on-scroll').forEach((el) => observer.observe(el));

            // Navbar only earns its hairline and shadow once it is actually
            // overlapping content. At rest it sits flush on the hero.
            const navbar = document.getElementById('erpNavbar');
            const syncNavbar = () => navbar?.classList.toggle('is-scrolled', window.scrollY > 8);
            syncNavbar();
            window.addEventListener('scroll', syncNavbar, { passive: true });

            // Theme toggle. The icon swap is handled in CSS off [data-theme],
            // so this only has to move the attribute and remember the choice.
            document.getElementById('themeToggle')?.addEventListener('click', () => {
                const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('quaderp-theme', next);
            });

            // Hamburger / mobile nav
            const hamburgerBtn = document.getElementById('hamburgerBtn');
            const mobileNav = document.getElementById('mobileNav');

            const setNav = (isOpen: boolean) => {
                hamburgerBtn?.classList.toggle('open', isOpen);
                mobileNav?.classList.toggle('open', isOpen);
                hamburgerBtn?.setAttribute('aria-expanded', String(isOpen));
                mobileNav?.setAttribute('aria-hidden', String(!isOpen));
                document.body.style.overflow = isOpen ? 'hidden' : '';
            };

            hamburgerBtn?.addEventListener('click', () => {
                setNav(!hamburgerBtn.classList.contains('open'));
            });

            mobileNav?.querySelectorAll('a').forEach((link) => {
                link.addEventListener('click', () => setNav(false));
            });

            // Escape closes the drawer, which is the one thing every user
            // tries when a full-screen overlay traps them.
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && mobileNav?.classList.contains('open')) {
                    setNav(false);
                    hamburgerBtn?.focus();
                }
            });
        </script>
	</body>
</html>

