---
interface Props {
	title: string;
    description: string;
    /* Structured data blocks. Passed in rather than hardcoded here because the
       page owns the content the schema describes (its FAQ, its offers) and a
       copy of it in the layout would drift the first time either changed. */
    jsonLd?: Record<string, unknown>[];
}

const { title, description, jsonLd = [] } = Astro.props;

import { SITE_URL, absUrl, appHref } from '../config/site';

/* Taken as a URL rather than imported for its side effect, which matters more
   than it looks.
 
   It has to leave public/: served as /css/quaderp.css under a filename that
   never changes and a one-day cache, a returning visitor could hold yesterday's
   stylesheet against today's markup, and the first page to use a new class
   would render unstyled with nothing to show why.
 
   But a plain `import` folds it into the page's CSS bundle together with every
   component's scoped styles, and that one merged file measurably costs more
   than the two separate ones did: the browser downloads one larger stylesheet
   instead of two in parallel, then parses and recalculates it in a single task
   that lands after first paint. Measured on this page it was one 489ms task
   instead of four short ones, 170ms of total blocking time against ~0, and
   Lighthouse mobile 96 against 99.
 
   `?url` emits the file as its own hashed asset under /_astro/ and hands back
   the path, so it keeps the immutable cache and keeps loading alongside the
   component bundle rather than inside it. */
import quaderpCss from '../styles/quaderp.css?url';
import { GA_ID } from '../config/analytics';

/* Derived, not literal. The old tags hardcoded the apex, which 308s to www,
   so every crawler and scraper was pointed at a redirect. */
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = absUrl('/images/og-cover.jpg');

/* The chrome's own CTAs. Neither the navbar nor the drawer knows which tier
   the visitor wants, so neither claims one: they carry where the click came
   from and let the signup page ask. Attaching a plan here would have sent a
   five-branch chain to the Single Branch card. */
const lp = Astro.url.pathname;
const navSignupHref = appHref({ cta: 'nav', lp });
const drawerSignupHref = appHref({ cta: 'mobile-nav', lp });

const whatsappNumber = "233530890302";
const whatsappMessage = "Hi Quadem! I'm interested in QuadERP for my store. Can we talk?";
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

		<!-- Paints the browser chrome to match whichever ground is showing. -->
		<meta name="theme-color" content="#f7f7fb" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#08071a" media="(prefers-color-scheme: dark)" />

		<!-- Open Graph / Social sharing.
		     og:image was the 1800x1125 dashboard PNG: 305KB for a card that gets
		     rendered at 1200x630, and cropped to that aspect by every scraper.
		     og-cover.jpg is built to the right aspect at 33KB. -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="The QuadERP dashboard, showing the day's sales in cedis alongside stock and theft alerts" />
		<meta property="og:locale" content="en_GH" />
		<meta property="og:site_name" content="QuadERP" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<title>{title}</title>

		<!-- Fonts are self-hosted.
		     They used to come from Google, which cost two DNS lookups and two TLS
		     handshakes to fonts.googleapis.com and fonts.gstatic.com before a
		     single glyph could be requested. On a high-latency mobile connection,
		     which is most of this audience, that is most of a second spent before
		     the download starts. Served from our own origin they arrive on the
		     connection the browser has already opened, and they can carry a
		     year-long immutable cache header (see vercel.json).

		     Latin subset only, and Inter is the variable file, so 400/500/600 are
		     one 47KB download rather than three. -->
		<link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/poppins-latin-600.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="stylesheet" href={quaderpCss} />

		{jsonLd.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}

        <!-- Applied before paint to avoid a flash of the wrong theme. An
             explicit choice wins; with nothing stored we follow the OS rather
             than forcing everyone onto light. -->
        <script>
            /* Marks the document as scripted before first paint. The scroll
               reveals park every section below the hero at opacity: 0, and that
               rule is now scoped to .js, so if this script never runs, or a
               network blip costs us the page's JS, the visitor gets the whole
               page rather than a hero above a column of blank space. */
            document.documentElement.classList.add('js');

            const stored = localStorage.getItem('quaderp-theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute(
                'data-theme',
                stored === 'dark' || stored === 'light' ? stored : (prefersDark ? 'dark' : 'light'),
            );
        </script>
        <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="K8bWFBn6V2/49PsFCMRFcA" async></script>

        <!-- Conversion tracking.
             Ahrefs above counts visits. This counts what they did: opened the
             demo, reached pricing, messaged us, started a trial. Without it
             there is no way to tell which part of the page is losing people.

             Nothing leaves the browser until PUBLIC_GA_ID is set. Unset, the
             events still queue on dataLayer, which is good for reading in a
             console and nothing else. -->
        <script is:inline define:vars={{ GA_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { window.dataLayer.push(arguments); }
            window.gtag = gtag;

            window.qerpTrack = function (name, props) {
                /* Two shapes, and both are needed. The object push is what a
                   GTM container reads. gtag.js does not read it: it only
                   processes entries shaped like an `arguments` object, which
                   is what gtag() above pushes. Without the second line a GA4
                   property records pageviews and not one single event below,
                   while looking from the dashboard exactly like it works. */
                window.dataLayer.push(Object.assign({ event: name }, props || {}));
                if (GA_ID) gtag('event', name, props || {});
            };

            /* Declarative rather than a listener per button: a CTA is tracked
               by adding data-track to it, so a new one cannot be added without
               the tracking coming with it. Delegated, so it also covers the
               buttons that are hidden at load (mobile drawer, success card). */
            document.addEventListener('click', function (e) {
                var el = e.target instanceof Element ? e.target.closest('[data-track]') : null;
                if (!el) return;
                window.qerpTrack(el.getAttribute('data-track'), {
                    label: el.getAttribute('data-track-label') || undefined,
                    location: el.getAttribute('data-track-where') || undefined,
                });
            });

            if (GA_ID) {
                var ga = document.createElement('script');
                ga.async = true;
                ga.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
                document.head.appendChild(ga);
                gtag('js', new Date());
                gtag('config', GA_ID);
            }
        </script>
	</head>
	<body>
        <a href="#erp-main" class="erp-skip-link">Skip to content</a>

        <!-- Header -->
        <header class="erp-navbar" id="erpNavbar">
