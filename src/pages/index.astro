         labelled as such, both in the section header and on every card. -->
    <section class="erp-scenarios section-padding" id="erp-scenarios">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <span class="erp-eyebrow">Worked examples</span>
