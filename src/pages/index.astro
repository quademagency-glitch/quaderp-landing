                        <h4 class="erp-scenario-subhead">Where the money goes</h4>
                        <p>{s.cost}</p>

                        <h4 class="erp-scenario-subhead">What QuadERP puts in front of you</h4>
                        <ul class="erp-feature-list">
                            {s.shows.map((item) => (<li>{item}</li>))}
                        </ul>

