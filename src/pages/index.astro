                        <ul class="tier-features">
                            {plan.features.map((feature) => (
                                <li>{feature}</li>
                            ))}
                        </ul>
                        <a href={plan.selfServe ? signupUrl(plan.name) : plan.href} class={`btn ${plan.isPopular ? 'btn-primary' : 'btn-ghost'} btn-pill tier-btn`}>{plan.buttonText}</a>
