                <div class="timeline-line"></div>
                <div class="process-steps" style="grid-template-columns: repeat(3, 1fr);">
                    <div class="process-step animate-on-scroll slide-up delay-100">
                        <div class="step-number">1</div>
                        <h3 class="step-title">Start Free</h3>
                        <p class="step-desc">Open your account in a few minutes. Thirty days, no card, no commitment.</p>
                    </div>
                    <div class="process-step animate-on-scroll slide-up delay-200">
                        <div class="step-number">2</div>
                        <h3 class="step-title">We Set You Up</h3>
                        <p class="step-desc">Our team loads your products, prices and opening stock, adds your branches, and trains your staff.</p>
                    </div>
                    <div class="process-step animate-on-scroll slide-up delay-300">
                        <div class="step-number">3</div>
                        <h3 class="step-title">Decide After 30 Days</h3>
                        <p class="step-desc">Move onto a paid plan or walk away. Either way the data is yours to take with you.</p>
                    </div>
                </div>
            </div>
        </div>
