                            <tr>
                                <th>Feature Category & Capabilities</th>
                                <th>Single Branch<br/><span class="tier-sub">GHS 250/mo</span></th>
                                <th>Multi-Branch<br/><span class="tier-sub">GHS 600/mo</span></th>
                                <th>Franchise<br/><span class="tier-sub">Custom</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {featureCategories.map((category) => (
                                <>
                                    <tr class="category-row">
                                        <td colspan="4">{category.name}</td>
                                    </tr>
                                    {category.features.map((feature) => (
                                        <tr>
                                            <td class="feature-name">{feature.name}</td>
                                            <td class={feature.single === 'Yes' ? 'text-accent' : feature.single === 'No' ? 'text-muted' : ''}>
                                                {feature.single === 'Yes' ? <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> :
                                                 feature.single === 'No' ? '-' : feature.single}
                                            </td>
                                            <td class={feature.multi === 'Yes' ? 'text-accent' : feature.multi === 'No' ? 'text-muted' : ''}>
                                                {feature.multi === 'Yes' ? <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> :
                                                 feature.multi === 'No' ? '-' : feature.multi}
                                            </td>
                                            <td class={feature.franchise === 'Yes' ? 'text-accent' : feature.franchise === 'No' ? 'text-muted' : ''}>
                                                {feature.franchise === 'Yes' ? <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> :
                                                 feature.franchise === 'No' ? '-' : feature.franchise}
                                            </td>
                                        </tr>
                                    ))}
                                </>
                            ))}
                        </tbody>
                    </table>
                </div>
                </details>
            </div>

            <!-- Pricing FAQ -->
            <div class="erp-faq animate-on-scroll slide-up delay-200">
