        icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/><line x1="9" y1="11" x2="9.01" y2="11"/><line x1="15" y1="11" x2="15.01" y2="11"/></svg>`,
        title: "Multi-Location",
        description: "One dashboard across every branch, cross-location stock transfers, per-branch reporting and per-location currency."
    }
];

/* The three things an owner is actually weighing QuadERP against. Each claim
   here is checkable, and no local competitor is named. */
const alternatives = [
    {
        heading: "“My book works fine.”",
        body: "You are already doing this work by hand. Counting stock on Sunday evening, adding up the day, trying to remember who took goods on credit. QuadERP does the same work as you sell, in seconds. And a book cannot tell you that a sale was voided at 9:14pm after you had gone home."
    },
    {
        heading: "“I'll just use a simple sales app.”",
        body: "Most of them record sales and stop there, which is the easy half of the job. QuadERP tracks stock across every branch, flags the void and shrinkage patterns that point to theft, and keeps a live list of exactly who owes you money."
    },
    {
        heading: "“What about the big foreign systems?”",
        body: "Square, Vend and Lightspeed are good software built for other markets. They do not take Mobile Money, they do not price in cedis by default, they do not plug into Arkesel or Paystack, and their support desk is asleep while your shop is open."
    }
];

/* Worked examples, not testimonials. QuadERP has no published customer
   results yet, so these show the arithmetic an owner can run on their own
   figures instead of putting invented people and outcomes on the page.
   The disclaimer above them in the markup is not decorative. */
const scenarios = [
    {
        label: "Scenario A",
        title: "A single-branch pharmacy in Accra",
        setup: "Two tills, six staff, roughly GHS 90,000 across the counter each month. Stock counted by hand on Sunday evenings. Regulars take goods on credit, written in a notebook behind the counter.",
        cost: "If shrinkage runs at 5%, a common figure for counter retail, that is GHS 4,500 a month leaving the shop unrecorded. The Sunday count takes four hours and still does not reconcile. Nobody can say what the credit book is owed, only that it is “plenty”.",
        shows: [
            "Every void and discount, with the staff member and the timestamp",
            "Stock variance by product after each count, so a gap surfaces the week it happens",
            "A receivables list naming each customer, the amount, and how many days old it is",
            "The Sunday count done by scanning, with the variance worked out for you"
        ],
        bottomLine: "You cannot recover what you cannot see. The first thing that changes is that the GHS 4,500 stops being invisible."
    },
    {
        label: "Scenario B",
        title: "A cosmetics chain across Accra and Kumasi",
        setup: "Two shops in Accra, one in Kumasi. Ordering happens when somebody notices a shelf looking empty, and each branch orders for itself.",
        cost: "Osu is holding forty units of a shade that has not moved in two months. Kumasi has been out of that same shade for three weeks and turning customers away. Head office orders more from the supplier, because nobody can see across the branches. Cash sits dead on one shelf while sales are lost on another.",
        shows: [
            "Stock levels in all three branches on one screen, side by side",
            "A transfer from Osu to Kumasi instead of a fresh supplier order",
            "Per-branch sales reporting, so you know which shop is actually carrying the chain",
            "Reorder suggestions built from each branch's own sales history"
        ],
        bottomLine: "The stock you need is often already inside your own business. You just cannot see it from where you are standing."
    }
];

type PricingPlan = {
    name: string;
    monthlyPrice: string; monthlyPeriod: string;
    yearlyPrice: string; yearlyPeriod: string;
    setupFee: string;
    description: string;
    features: string[];
    isPopular: boolean;
    buttonText: string;
    /* Exactly one of these. `selfServe` tiers build their own signup link from
       the tier name; anything else states where it goes. */
    selfServe?: boolean;
    href?: string;
    setupLabel?: string;
    setupNote?: string;
};

const defaultPricingPlans: PricingPlan[] = [
    {
        name: "Single Branch",
        monthlyPrice: "GHS 250", monthlyPeriod: "/mo",
        yearlyPrice: "GHS 2,750", yearlyPeriod: "/yr",
        setupFee: "GHS 1,000",
        description: "One shop, run properly. Know what sold, what is left, and what your staff did with it.",
        features: [
            "1 Store Location",
            "Up to 3 POS Terminals",
            "Real-time Inventory Tracking",
            "Accounting, Invoicing & Receivables",
            "Sales Dashboard & Top Sellers",
            "Standard Support"
        ],
        /* `selfServe` drives the signup link: the href is built from the tier
           name so the choice made here survives the jump to the app. Franchise
           is quoted by hand and sets its own href instead. */
