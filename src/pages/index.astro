            <p class="erp-scenarios-disclaimer animate-on-scroll slide-up">
                <strong>These are illustrations, not customer stories.</strong>
                QuadERP is new to market and we are not going to put invented people on our website.
                The businesses below are composites, and the figures are arithmetic on ordinary retail
                numbers, shown so you can check the maths against your own shop.
            </p>

            <div class="erp-scenarios-grid">
                {scenarios.map((s, index) => (
                    <article class={`erp-scenario-card erp-surface animate-on-scroll slide-up delay-${(index + 1) * 100}`}>
                        <span class="erp-scenario-label">{s.label} · Illustration</span>
