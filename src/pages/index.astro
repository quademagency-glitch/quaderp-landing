---
import Layout from '../layouts/Layout.astro';

const defaultFeatures = [
    {
        icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>`,
        title: "Sales Dashboard",
        description: "Track revenue, transactions, average order value, and weekly trends with real-time visual analytics."
    },
    {
        icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
        title: "Sales POS",
        description: "A fast, intuitive point-of-sale with product search, cart management, and multi-payment support."
    },
    {
        icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7h-3a2 2 0 0 1-2-2V2"/><path d="M9 18a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h7l4 4v10a2 2 0 0 1-2 2H9z"/><path d="M3 7v10a2 2 0 0 0 2 2h6"/><line x1="12" y1="11" x2="16" y2="11"/><line x1="12" y1="15" x2="16" y2="15"/></svg>`,
        title: "Inventory Management",
        description: "Monitor stock levels with color-coded health indicators, SKU tracking, and automatic low-stock alerts."
    },
    {
        icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
        title: "Loss Prevention Alerts",
        description: "Track voids, suspicious patterns, shrinkage, stock discrepancies, and after-hours activity in real time."
    },
    {
        icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
        title: "CRM & Team Management",
        description: "Manage customers, staff roles and permissions, and track team performance across all locations."
    },
    {
        icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
        title: "Accounting & Invoicing",
        description: "Generate invoices, reconcile payments, and keep your books clean with built-in accounting tools."
    }
];

const defaultPricingPlans = [
    {
        name: "Single Branch", 
        monthlyPrice: "GHS 450", monthlyPeriod: "/mo", 
        yearlyPrice: "GHS 4,950", yearlyPeriod: "/yr",
        setupFee: "GHS 1,500",
        description: "Perfect for single-location retail stores and pharmacies getting started.",
        features: [
            "1 Store Location", 
            "Up to 3 POS Terminals", 
            "Basic Sales Dashboard", 
            "Real-time Inventory Tracking", 
            "Built-in Accounting & Invoicing",
            "Standard Support"
        ],
        isPopular: false, buttonText: "Contact Us"
    },
    {
        name: "Multi-Branch", 
        monthlyPrice: "GHS 1,000", monthlyPeriod: "/mo", 
        yearlyPrice: "GHS 11,000", yearlyPeriod: "/yr",
        setupFee: "GHS 5,500",
        description: "The ideal plan for growing businesses with 2 to 5 store locations.",
        features: [
            "Up to 5 Store Locations", 
            "Unlimited POS Terminals", 
            "Advanced Analytics & Loss Prevention", 
            "Multi-store Stock Transfers", 
            "CRM & Advanced Team Management",
            "Priority Support"
        ],
        isPopular: true, buttonText: "Contact Us"
    },
    {
        name: "Franchise", 
        monthlyPrice: "Custom", monthlyPeriod: "", 
        yearlyPrice: "Custom", yearlyPeriod: "",
        setupFee: "Custom Quote",
        description: "Tailored value-based solutions for large retail chains and distributors.",
        features: [
            "Unlimited Locations", 
            "Custom API Integrations", 
            "Legacy Data Migration", 
            "On-site Staff Training", 
            "Dedicated Account Manager", 
            "Custom SLA & 99.9% Uptime"
        ],
        isPopular: false, buttonText: "Contact Sales"
    }
];

const featureCategories = [
    {
        name: "Platform Basics",
        features: [
            { name: "Max Store Locations", single: "1 Location", multi: "Up to 5 Locations", franchise: "Unlimited Locations" },
            { name: "Setup Fee", single: "GHS 1500", multi: "GHS 5500", franchise: "Custom Quote" },
            { name: "Support Level", single: "Standard Support", multi: "Priority Support", franchise: "Dedicated Account Mgr" }
        ]
    },
    {
        name: "Point of Sale (POS)",
        features: [
            { name: "Max POS Terminals", single: "Up to 3", multi: "Unlimited", franchise: "Unlimited" },
            { name: "Touch-Optimized Register", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Multi-Payment (Cash/Card/Momo)", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Returns & Refunds", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Till Management (Cash Drawer)", single: "Yes", multi: "Yes", franchise: "Yes" }
        ]
    },
    {
        name: "Inventory & Stock Control",
        features: [
            { name: "Real-time Stock Sync", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Low Stock Alerts", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Stock Adjustments & Reconciliation", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Multi-Store Stock Transfers", single: "No", multi: "Yes", franchise: "Yes" },
            { name: "Centralized Warehouse Routing", single: "No", multi: "Yes", franchise: "Yes" }
        ]
    },
    {
        name: "Business Dashboard & Analytics",
        features: [
            { name: "Basic Sales Metrics & Charts", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Top Selling Products", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Advanced Loss Prevention Alerts", single: "No", multi: "Yes", franchise: "Yes" },
            { name: "Employee Performance Tracking", single: "No", multi: "Yes", franchise: "Yes" },
            { name: "Cross-Location Comparison", single: "No", multi: "Yes", franchise: "Yes" }
        ]
    },
    {
        name: "Integrated Accounting & Invoicing",
        features: [
            { name: "B2B Invoicing generation", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Accounts Receivable (Who owes you)", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Accounts Payable (Who you owe)", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Basic Expense Logging", single: "Yes", multi: "Yes", franchise: "Yes" }
        ]
    },
    {
        name: "CRM & Customer Loyalty",
        features: [
            { name: "Customer Profiles & History", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Loyalty Points & Rewards", single: "No", multi: "Yes", franchise: "Yes" },
            { name: "Marketing Comms (SMS/Email)", single: "No", multi: "Yes", franchise: "Yes" }
        ]
    },
    {
        name: "Purchasing & Supply Chain",
        features: [
            { name: "Supplier Directory", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Create Purchase Orders (POs)", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Auto-Receive POs into Stock", single: "Yes", multi: "Yes", franchise: "Yes" }
        ]
    },
    {
        name: "Staff Management & Security",
        features: [
            { name: "Basic Staff Profiles", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Advanced Role-Based Permissions", single: "No", multi: "Yes", franchise: "Yes" },
            { name: "Detailed Activity Audit Logs", single: "No", multi: "Yes", franchise: "Yes" }
        ]
    },
    {
        name: "Enterprise / Technical Extras",
        features: [
            { name: "Custom API Integrations", single: "No", multi: "No", franchise: "Yes" },
            { name: "Legacy Data Migration", single: "No", multi: "No", franchise: "Yes" },
            { name: "On-site Staff Training", single: "No", multi: "No", franchise: "Yes" },
            { name: "Custom SLA (99.9% Uptime)", single: "No", multi: "No", franchise: "Yes" }
        ]
    }
];

const benefits = [
    { icon: "☁️", title: "100% Cloud-Based", desc: "No servers to maintain. Access everything from your browser, anywhere in the world." },
    { icon: "⚡", title: "Real-Time Sync", desc: "Every sale, every stock change, every alert — synced across all devices instantly." },
    { icon: "🏪", title: "Multi-Store Support", desc: "Manage multiple locations from a single dashboard with store-level permissions." },
    { icon: "🔒", title: "Bank-Grade Security", desc: "End-to-end encryption, role-based access control, and secure cloud infrastructure." },
    { icon: "📱", title: "No Hardware Required", desc: "Works on any device with a browser. No POS hardware or special equipment needed." },
    { icon: "🔄", title: "Automatic Updates", desc: "Always running the latest version. New features and improvements delivered seamlessly." }
];

const whatsappNumber = "233530890302";
const whatsappMessage = "Hi Quadem! I'm interested in QuadERP for my store. Can we talk?";
---

<Layout 
    title="QuadERP — All-in-One Store Management Platform" 
    description="QuadERP is a powerful, cloud-based ERP for retail stores. Track sales, manage inventory, oversee staff, and prevent losses — all in one app."
>
    <!-- ===== HERO ===== -->
    <section class="erp-hero" id="erp-hero">
        <div class="erp-hero-bg">
            <div class="erp-hero-gradient"></div>
            <div class="erp-hero-grid-pattern"></div>
            <div class="erp-glow-orb orb-1"></div>
            <div class="erp-glow-orb orb-2"></div>
            <div class="erp-glow-orb orb-3"></div>
            <div class="hero-noise"></div>
        </div>
        <div class="container erp-hero-container">
            <div class="erp-hero-content animate-on-scroll slide-up">
                <span class="erp-badge">🚀 Introducing QuadERP</span>
                <h1 class="erp-hero-title">
                    Take Control of Your <span class="text-gradient">Store Operations</span>
                </h1>
                <p class="erp-hero-subtitle">
                    Real-time sales tracking, smart inventory management, staff oversight, and theft prevention — all in one powerful platform built for modern retail.
                </p>
                <div class="erp-hero-ctas">
                    <a href="#erp-contact" class="btn btn-primary btn-pill glow-effect erp-btn-lg">Contact Us To Get Set Up</a>
                    <a href="#erp-showcase" class="btn btn-ghost btn-pill erp-btn-lg">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                        See It In Action
                    </a>
                </div>
                <div class="erp-hero-trust">
                    <span>✓ Setup handled by us</span>
                    <span>✓ Personalized onboarding</span>
                    <span>✓ Built for scale</span>
                </div>
            </div>
            <div class="erp-hero-visual animate-on-scroll slide-left delay-200">
                <div class="erp-mockup-wrapper">
                    <img src="/images/quaderp-dashboard.png" alt="QuadERP Dashboard" class="erp-mockup-img" width="800" height="500" />
                    <div class="erp-mockup-glow"></div>
                </div>
            </div>
        </div>
        <div class="erp-hero-scroll-indicator">
            <span>Scroll to explore</span>
            <div class="erp-scroll-arrow">↓</div>
        </div>
    </section>

    <!-- ===== STATS STRIP ===== -->
    <section class="erp-stats" id="erp-stats">
        <div class="container stats-container">
            <div class="stat-item">
                <h3 class="stat-number erp-stat-text" data-target="0">Real-time</h3>
                <p class="stat-label">Inventory Sync</p>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <h3 class="stat-number" data-target="50">50%</h3>
                <p class="stat-label">Less Shrinkage</p>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <h3 class="stat-number" data-target="2">2x</h3>
                <p class="stat-label">Faster Operations</p>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <h3 class="stat-number erp-stat-text" data-target="0">24/7</h3>
                <p class="stat-label">Cloud Access</p>
            </div>
        </div>
    </section>

    <!-- ===== FEATURES ===== -->
    <section class="erp-features section-padding" id="erp-features">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2><span class="text-gradient">Everything You Need</span> to Run Your Store</h2>
                <p>Powerful tools designed for retail businesses of every size — from single shops to multi-location chains.</p>
            </div>

            <div class="erp-features-grid">
                {defaultFeatures.map((feature, index) => (
                    <div class={`service-card glow-card animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                        <div class="service-icon" set:html={feature.icon} />
                        <h3 class="service-title">{feature.title}</h3>
                        <p class="service-desc">{feature.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ===== APP SHOWCASE ===== -->
    <section class="erp-showcase section-padding" id="erp-showcase" style="background: var(--bg-surface); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2>See <span class="text-gradient">QuadERP</span> in Action</h2>
                <p>A powerful, intuitive interface designed for speed and clarity.</p>
            </div>

            <!-- Showcase 1: Dashboard -->
            <div class="erp-showcase-row">
                <div class="erp-showcase-image animate-on-scroll slide-right">
                    <div class="erp-showcase-img-wrapper glow-effect">
                        <img src="/images/quaderp-dashboard.png" alt="QuadERP Sales Dashboard with analytics" width="600" height="400" />
                    </div>
                </div>
                <div class="erp-showcase-content animate-on-scroll slide-left delay-200">
                    <span class="erp-showcase-label">Sales Dashboard</span>
                    <h3>Know Your Numbers <span class="text-gradient">Instantly</span></h3>
                    <p>Track total revenue, daily transactions, average order value, and sales trends — all updated in real time. No more guesswork.</p>
                    <ul class="erp-feature-list">
                        <li>Live revenue tracking across registers</li>
                        <li>Visual weekly and monthly trend charts</li>
                        <li>Top-selling products and categories</li>
                        <li>Customizable date range comparisons</li>
                    </ul>
                </div>
            </div>

            <!-- Showcase 2: Inventory -->
            <div class="erp-showcase-row erp-showcase-reverse">
                <div class="erp-showcase-image animate-on-scroll slide-left">
                    <div class="erp-showcase-img-wrapper glow-effect">
                        <img src="/images/quaderp-inventory.png" alt="QuadERP Inventory Management screen" width="600" height="400" />
                    </div>
                </div>
                <div class="erp-showcase-content animate-on-scroll slide-right delay-200">
                    <span class="erp-showcase-label">Inventory Control</span>
                    <h3>Never Run Out of <span class="text-gradient">Stock Again</span></h3>
                    <p>See every product, its stock level, and health status at a glance. Color-coded indicators make it easy to spot what needs attention.</p>
                    <ul class="erp-feature-list">
                        <li>Real-time stock level monitoring</li>
                        <li>Low-stock and critical alerts</li>
                        <li>Product detail with history charts</li>
                        <li>SKU search and category filtering</li>
                    </ul>
                </div>
            </div>

            <!-- Showcase 3: Sales POS -->
            <div class="erp-showcase-row">
                <div class="erp-showcase-image animate-on-scroll slide-right">
                    <div class="erp-showcase-img-wrapper glow-effect">
                        <img src="/images/quaderp-pos.png" alt="QuadERP Point of Sale interface" width="600" height="400" />
                    </div>
                </div>
                <div class="erp-showcase-content animate-on-scroll slide-left delay-200">
                    <span class="erp-showcase-label">Sales POS</span>
                    <h3>Sell Faster With a <span class="text-gradient">Modern POS</span></h3>
                    <p>A sleek, touch-friendly point-of-sale that your staff will love. Browse products, build carts, and process payments — all from one screen.</p>
                    <ul class="erp-feature-list">
                        <li>Visual product grid with quick-add buttons</li>
                        <li>Multi-payment: Cash, Card, and Mobile Money</li>
                        <li>Customer search and order association</li>
                        <li>Real-time cart with quantity controls</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== HOW IT WORKS ===== -->
    <section class="process section-padding" id="erp-process">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2>Get Started in <span class="text-gradient">3 Simple Steps</span></h2>
                <p>We handle the heavy lifting so you can focus on your business.</p>
            </div>
            <div class="process-timeline">
                <div class="timeline-line"></div>
                <div class="process-steps" style="grid-template-columns: repeat(3, 1fr);">
                    <div class="process-step animate-on-scroll slide-up delay-100">
                        <div class="step-number">1</div>
                        <h3 class="step-title">Contact Us</h3>
                        <p class="step-desc">Reach out to our team to discuss your specific store needs and requirements.</p>
                    </div>
                    <div class="process-step animate-on-scroll slide-up delay-200">
                        <div class="step-number">2</div>
                        <h3 class="step-title">We Set You Up</h3>
                        <p class="step-desc">We configure your instance, set up your locations, and help import initial data.</p>
                    </div>
                    <div class="process-step animate-on-scroll slide-up delay-300">
                        <div class="step-number">3</div>
                        <h3 class="step-title">Start Managing</h3>
                        <p class="step-desc">You and your staff log in and start using QuadERP instantly.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== BENEFITS ===== -->
    <section class="erp-benefits section-padding" id="erp-benefits">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2>Why Choose <span class="text-gradient">QuadERP</span></h2>
                <p>Built different. Built better. Here's what sets us apart.</p>
            </div>
            <div class="erp-benefits-grid">
                {benefits.map((benefit, index) => (
                    <div class={`erp-benefit-card animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                        <div class="erp-benefit-icon">{benefit.icon}</div>
                        <h3 class="erp-benefit-title">{benefit.title}</h3>
                        <p class="erp-benefit-desc">{benefit.desc}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ===== PRICING ===== -->
    <section class="pricing section-padding" id="erp-pricing" style="background: var(--bg-surface); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2><span class="text-gradient">Simple, Transparent Pricing</span></h2>
                <p>Start small, scale as you grow. No hidden fees.</p>

                <div class="pricing-toggle-container">
                    <span class="toggle-label active" id="label-monthly">Monthly</span>
                    <label class="erp-toggle">
                        <input type="checkbox" id="pricing-toggle">
                        <span class="erp-toggle-slider"></span>
                    </label>
                    <span class="toggle-label" id="label-yearly">Annually <span class="discount-badge">1 Month Free</span></span>
                </div>
            </div>
            <div class="pricing-grid">
                {defaultPricingPlans.map((plan, index) => (
                    <div class={`pricing-card ${plan.isPopular ? 'popular-tier' : ''} animate-on-scroll slide-up delay-${(index + 1) * 100}`}>
                        {plan.isPopular && <div class="popular-badge">Most Popular</div>}
                        <h3 class="tier-name">{plan.name}</h3>
                        <div class="tier-price" data-monthly-price={plan.monthlyPrice} data-yearly-price={plan.yearlyPrice} data-monthly-period={plan.monthlyPeriod} data-yearly-period={plan.yearlyPeriod}>
                            <span class="price-amount">{plan.monthlyPrice}</span><span class="erp-price-period">{plan.monthlyPeriod}</span>
                        </div>
                        {plan.setupFee && (
                            <div class="tier-setup-fee">
                                + {plan.setupFee} Setup Fee
                            </div>
                        )}
                        <p class="tier-desc">{plan.description}</p>
                        <ul class="tier-features">
                            {plan.features.map((feature) => (
                                <li>{feature}</li>
                            ))}
                        </ul>
                        <a href="#erp-contact" class={`btn ${plan.isPopular ? 'btn-primary glow-effect' : 'btn-ghost'} btn-pill tier-btn`}>{plan.buttonText}</a>
                    </div>
                ))}
            </div>
            <div class="erp-pricing-note animate-on-scroll slide-up">
                <p>🔒 Contact us to secure your pricing and get started.</p>
            </div>

            <!-- Compare Features Matrix -->
            <div class="erp-compare-features animate-on-scroll slide-up delay-200">
                <details class="erp-compare-details">
                    <summary class="compare-title">
                        <span>Compare Plan Features</span>
                        <svg class="compare-chevron" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </summary>
                    <div class="table-responsive">
                    <table class="erp-feature-table">
                        <thead>
                            <tr>
                                <th>Feature Category & Capabilities</th>
                                <th>Single Branch<br/><span class="tier-sub">GHS 450/mo</span></th>
                                <th>Multi-Branch<br/><span class="tier-sub">GHS 1000/mo</span></th>
                                <th>Franchise<br/><span class="tier-sub">Custom</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {featureCategories.map((category) => (
                                <>
                                    <tr class="category-row">
                                        <td colspan="4">{category.name}</td>
                                    </tr>
                                    {category.features.map((feature) => (
                                        <tr>
                                            <td class="feature-name">{feature.name}</td>
                                            <td class={feature.single === 'Yes' ? 'text-accent' : feature.single === 'No' ? 'text-muted' : ''}>
                                                {feature.single === 'Yes' ? <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> : 
                                                 feature.single === 'No' ? '-' : feature.single}
                                            </td>
                                            <td class={feature.multi === 'Yes' ? 'text-accent' : feature.multi === 'No' ? 'text-muted' : ''}>
                                                {feature.multi === 'Yes' ? <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> : 
                                                 feature.multi === 'No' ? '-' : feature.multi}
                                            </td>
                                            <td class={feature.franchise === 'Yes' ? 'text-accent' : feature.franchise === 'No' ? 'text-muted' : ''}>
                                                {feature.franchise === 'Yes' ? <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> : 
                                                 feature.franchise === 'No' ? '-' : feature.franchise}
                                            </td>
                                        </tr>
                                    ))}
                                </>
                            ))}
                        </tbody>
                    </table>
                </div>
                </details>
            </div>
        </div>
    </section>

    <!-- ===== CONTACT & BOOKING ===== -->
    <section class="erp-contact-section section-padding" id="erp-contact">
