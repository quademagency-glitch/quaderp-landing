        ]
    },
    {
        name: "Purchasing & Supply Chain",
        features: [
            { name: "Supplier Directory", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Create Purchase Orders (POs)", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Auto-Receive POs into Stock", single: "Yes", multi: "Yes", franchise: "Yes" }
        ]
    },
    {
        name: "Staff Management & Security",
        features: [
            { name: "Basic Staff Profiles", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Advanced Role-Based Permissions", single: "No", multi: "Yes", franchise: "Yes" },
            { name: "Detailed Activity Audit Logs", single: "No", multi: "Yes", franchise: "Yes" }
        ]
    },
    {
        name: "Enterprise / Technical Extras",
        features: [
            { name: "Custom API Integrations", single: "No", multi: "No", franchise: "Yes" },
            { name: "Legacy Data Migration", single: "No", multi: "No", franchise: "Yes" },
            { name: "On-site Staff Training", single: "No", multi: "No", franchise: "Yes" },
            { name: "Custom SLA (99.9% Uptime)", single: "No", multi: "No", franchise: "Yes" }
        ]
    }
];

const pricingFaqs = [
    {
        q: "Is the free trial really free?",
        a: "Yes. Thirty days, no card at signup, and nothing to cancel if you decide to walk away. We would rather you test it in your own shop than take our word for it."
    },
    {
        q: "What does the setup fee actually pay for?",
        a: "Our team loading your products, prices and opening stock, setting up your branches, and training your staff so they can work the till on day one. It is a one-time charge, and it only falls due when you move onto a paid plan after the trial."
    },
    {
        q: "Do I need to buy a POS machine or any special hardware?",
        a: "No. QuadERP runs in a browser on the phone, tablet or laptop you already have. If you want a barcode scanner later, our scanner app turns a phone into one."
    },
    {
        q: "Can I start on Single Branch and move up later?",
        a: "Yes. When you open a second shop we move you to Multi-Branch. You pay the difference in the monthly fee, plus a one-time top-up on setup, which is the difference between the two setup fees. So GHS 1,500 on top of the GHS 1,000 you already paid, not a fresh GHS 2,500."
    },
    {
        q: "What happens to my data if I stop paying?",
        a: "It stays yours. For 30 days after you cancel, ask us and we will export your products, sales, customers and ledger into files you keep. We do not hold your business records hostage to a subscription."
    },
    {
        q: "Can I take Mobile Money through it?",
        a: "Yes. Cash, card and Mobile Money at the counter, including splitting one sale across two payment methods. Card processing runs through Paystack."
    },
    {
        q: "I have more than five branches. What then?",
        a: "That is the Franchise plan. Tell us the shape of your business and we will quote for it, including migrating your data across from whatever you are running now."
    },
    {
        q: "Is paying yearly worth it?",
        a: "It is twelve months for the price of eleven. Same product, one less invoice to think about during the year."
    }
];
---

<Layout
    title="QuadERP | Store Management Software for Retail in Ghana"
    description="QuadERP helps Ghanaian shops track sales, manage stock across branches, catch staff theft, and know who owes them. Free for 30 days, no card needed."
>
    <!-- ===== HERO ===== -->
    <section class="erp-hero" id="erp-hero">
        <div class="erp-hero-bg"></div>
        <div class="container erp-hero-container">
            <div class="erp-hero-content">
                <span class="erp-badge hero-reveal">Built for shops across Ghana</span>
                {/* Two-tone rather than a gradient-clipped span: the set-up
                    clause sits back in the muted ink and the phrase that does
                    the work stays at full strength. */}
                <h1 class="erp-hero-title hero-reveal hero-delay-1">
                    <span class="hl-soft">Stop Losing Money to</span>
                    Theft and Stockouts
                </h1>
                <p class="erp-hero-subtitle hero-reveal hero-delay-2">
                    See what's selling, what's in stock, and what your staff are doing across every branch, right from your phone.
                </p>
                <div class="erp-hero-ctas hero-reveal hero-delay-3">
                    <a href={SIGNUP_URL} class="btn btn-primary btn-pill erp-btn-lg">Start Your 30-Day Free Trial</a>
                    {/* Scrolls down to the demo section rather than jumping
                        straight into the sandbox: the owner gets to see what
                        the screens look like before deciding to open one. The
                        sandbox link itself lives at the end of that section. */}
                    <a href="#erp-showcase" class="btn btn-ghost btn-pill erp-btn-lg">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 9px;" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.3-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14z"/></svg>
                        Try Live Demo
                    </a>
                </div>
                <ul class="erp-hero-trust hero-reveal hero-delay-4">
                    <li><span class="erp-check" aria-hidden="true"></span>No credit card needed</li>
                    <li><span class="erp-check" aria-hidden="true"></span>We set you up and train your staff</li>
                    <li><span class="erp-check" aria-hidden="true"></span>Pay nothing until you decide to stay</li>
                </ul>
            </div>
        </div>
        <!-- Outside .container so it can run past the viewport's right edge. -->
        <div class="erp-hero-visual hero-reveal-x hero-delay-5">
            <div class="erp-hero-parallax" id="heroParallax">
                <div class="erp-mockup-wrapper">
                    <img src="/images/quaderp-dashboard.png" alt="The QuadERP dashboard showing today's sales in cedis, stock alerts and theft alerts" class="erp-mockup-img" width="1800" height="1125" fetchpriority="high" />
                </div>
            </div>
        </div>
        {/* Names the destination rather than saying "scroll to explore", and
            it no longer bounces on a loop. */}
        <a href="#erp-pains" class="erp-hero-scroll-indicator">
            <span>What shop owners tell us</span>
            <span class="erp-scroll-arrow" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4.5v15M6 13.5l6 6 6-6"/></svg>
            </span>
        </a>
    </section>

    <!-- ===== BUILT FOR GHANA STRIP =====
         Replaces the old stats bar. Every line is a capability we ship, not a
         performance figure that would need a customer to stand behind it. -->
    <section class="erp-proof" id="erp-proof">
        <div class="container">
            <p class="erp-proof-kicker">Built here, for how business actually runs here</p>
            <ul class="erp-proof-grid">
                {ghanaProof.map((item) => (
                    <li class="erp-proof-item">
                        <span class="erp-proof-check" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                        <strong>{item.title}</strong>
                        <span>{item.desc}</span>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- ===== PAIN POINTS ===== -->
    <section class="erp-pains section-padding" id="erp-pains">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <span class="erp-eyebrow">In the field</span>
                <h2><span class="hl-soft">If You've Said Any of This,</span> We Built This for You</h2>
                <p>Six sentences we hear in almost every shop we walk into.</p>
            </div>
            <div class="erp-pains-grid">
                {painPoints.map((pain, index) => (
                    <div class={`erp-pain-card erp-surface animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                        <blockquote class="erp-pain-quote">{pain.quote}</blockquote>
                        <div class="erp-pain-answer">
                            <span class="erp-pain-arrow" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                            </span>
                            <p>{pain.answer}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ===== LOSS PREVENTION =====
         Pulled out of the feature grid and given its own section. It is the
         one capability the competition does not ship, so it should not be
         sitting as one card among six. -->
    <section class="erp-lossprev section-padding" id="erp-lossprev">
        <div class="container">
            <div class="erp-lossprev-row">
                <div class="erp-lossprev-content animate-on-scroll slide-right">
                    <span class="erp-showcase-label">Loss Prevention</span>
                    <h2><span class="hl-soft">The Part Other Systems</span> Leave Out</h2>
                    <p>
                        Most shop software records sales. It will just as happily record the sale that never
                        happened, the void at 9:14pm, the twelve units that left the shelf without a receipt.
                        Recording is not the same as catching.
                    </p>
                    <p>
                        QuadERP watches for the patterns theft leaves behind and puts them in front of you
                        with a name and a time attached.
                    </p>
                    <ul class="erp-feature-list">
                        <li>Void and discount patterns, flagged per staff member</li>
                        <li>Logins and sales that happen outside your trading hours</li>
                        <li>Stock counts that don't match what was actually sold</li>
                        <li>Shrinkage tracked by product, by branch and by person</li>
                        <li>Every sale, stock movement and alert carries the staff member, the time and the branch</li>
                    </ul>
                </div>
                <div class="erp-lossprev-image animate-on-scroll slide-left delay-200">
                    <div class="erp-showcase-img-wrapper">
                        <img src="/images/quaderp-alerts.png" alt="QuadERP loss prevention alerts, each naming the staff member, the alert type and the time" width="1800" height="1041" loading="lazy" decoding="async" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== FEATURES ===== -->
    <section class="erp-features section-padding section-alt" id="erp-features">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <span class="erp-eyebrow">The rest of the system</span>
                <h2>Everything Else You Need to Run the Shop</h2>
                <p>One system instead of a book, a spreadsheet and a POS machine that don't talk to each other.</p>
            </div>

            <div class="erp-features-grid">
                {defaultFeatures.map((feature, index) => (
                    <div class={`service-card erp-surface animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                        <div class="service-icon" set:html={feature.icon} />
                        <h3 class="service-title">{feature.title}</h3>
                        <p class="service-desc">{feature.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ===== APP SHOWCASE ===== -->
