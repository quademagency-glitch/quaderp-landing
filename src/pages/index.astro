---
import Layout from '../layouts/Layout.astro';
import { SIGNUP_URL, DEMO_URL, signupUrl } from '../config/site';

const whatsappNumber = "233530890302";
const whatsappMessage = "Hi Quadem! I'm interested in QuadERP for my store. Can we talk?";
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

/* The five things a shop owner here checks for that a foreign system fails.
   Every claim is a capability, not a performance stat, so nothing on this
   strip needs a customer to substantiate it. */
const ghanaProof = [
    { title: "Mobile Money", desc: "Take MoMo at the counter, not just cash and card." },
    { title: "Priced in Cedis", desc: "GHS throughout, with per-location currency for the borders." },
    { title: "No Hardware to Buy", desc: "Runs in a browser on the phone or laptop you already own." },
    { title: "SMS That Arrives", desc: "Customer campaigns sent through Arkesel, not a foreign gateway." },
    { title: "Paystack Payments", desc: "Card processing through a processor built for this market." }
];

/* Straight from what shop owners say in the field. The quote does the
   selling; the answer just names the screen that handles it. */
const painPoints = [
    {
        quote: "I don't know what's selling and what's sitting on the shelf.",
        answer: "Your dashboard ranks every product by what actually moved this week. Reorder what sells, stop tying up cash in what doesn't."
    },
    {
        quote: "My staff are stealing from me and I can't prove it.",
        answer: "Loss prevention flags void patterns, after-hours activity and stock that doesn't add up, with the staff name and the time attached."
    },
    {
        quote: "I have no idea how my other branch is doing unless I go there.",
        answer: "Every branch reports into one dashboard. Check today's sales in Kumasi from your phone in Accra."
    },
    {
        quote: "I write everything in a book and work out profit at month end.",
        answer: "Profit and loss updates as you sell. You stop waiting until month end to find out how the month went."
    },
    {
        quote: "Customers owe me money and I've lost track of who and how much.",
        answer: "Accounts receivable lists every customer who owes you, the amount, and how many days it has been sitting there."
    },
    {
        quote: "I ordered too much of one thing and ran out of another.",
        answer: "Low-stock alerts warn you before the shelf is empty, and purchase orders are built from what your own sales history says you need."
    }
];

const defaultFeatures = [
    {
        icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
        title: "Point of Sale",
        description: "Cash, card, Mobile Money and split payments across them. Returns, refunds and a till that reconciles at close of day."
    },
    {
        icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7h-3a2 2 0 0 1-2-2V2"/><path d="M9 18a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h7l4 4v10a2 2 0 0 1-2 2H9z"/><path d="M3 7v10a2 2 0 0 0 2 2h6"/><line x1="12" y1="11" x2="16" y2="11"/><line x1="12" y1="15" x2="16" y2="15"/></svg>`,
        title: "Inventory Control",
        description: "Live stock levels, low-stock alerts, transfers between branches, stocktake reconciliation and barcode scanning from a phone."
    },
    {
        icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
        title: "Accounting & Invoicing",
        description: "B2B invoices, who owes you, who you owe, expenses and deposits from MoMo, POS machine or bank, all posting to one ledger."
    },
    {
        icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
        title: "CRM & Loyalty",
        description: "Customer profiles with full purchase history, loyalty points, gift cards, store credit and SMS or email campaigns."
    },
    {
        icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>`,
        title: "Team Management",
        description: "Role-based permissions, activity audit logs, employee performance tracking and attendance for every member of staff."
    },
    {
        icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/><line x1="9" y1="11" x2="9.01" y2="11"/><line x1="15" y1="11" x2="15.01" y2="11"/></svg>`,
        title: "Multi-Location",
        description: "One dashboard across every branch, cross-location stock transfers, per-branch reporting and per-location currency."
    }
];

/* The three things an owner is actually weighing QuadERP against. Each claim
   here is checkable, and no local competitor is named. */
const alternatives = [
    {
        heading: "“My book works fine.”",
        body: "You are already doing this work by hand. Counting stock on Sunday evening, adding up the day, trying to remember who took goods on credit. QuadERP does the same work as you sell, in seconds. And a book cannot tell you that a sale was voided at 9:14pm after you had gone home."
    },
    {
        heading: "“I'll just use a simple sales app.”",
        body: "Most of them record sales and stop there, which is the easy half of the job. QuadERP tracks stock across every branch, flags the void and shrinkage patterns that point to theft, and keeps a live list of exactly who owes you money."
    },
    {
        heading: "“What about the big foreign systems?”",
        body: "Square, Vend and Lightspeed are good software built for other markets. They do not take Mobile Money, they do not price in cedis by default, they do not plug into Arkesel or Paystack, and their support desk is asleep while your shop is open."
    }
];

/* Worked examples, not testimonials. QuadERP has no published customer
   results yet, so these show the arithmetic an owner can run on their own
   figures instead of putting invented people and outcomes on the page.
   The disclaimer above them in the markup is not decorative. */
const scenarios = [
    {
        label: "Scenario A",
        title: "A single-branch pharmacy in Accra",
        setup: "Two tills, six staff, roughly GHS 90,000 across the counter each month. Stock counted by hand on Sunday evenings. Regulars take goods on credit, written in a notebook behind the counter.",
        cost: "If shrinkage runs at 5%, a common figure for counter retail, that is GHS 4,500 a month leaving the shop unrecorded. The Sunday count takes four hours and still does not reconcile. Nobody can say what the credit book is owed, only that it is “plenty”.",
        shows: [
            "Every void and discount, with the staff member and the timestamp",
            "Stock variance by product after each count, so a gap surfaces the week it happens",
            "A receivables list naming each customer, the amount, and how many days old it is",
            "The Sunday count done by scanning, with the variance worked out for you"
        ],
        bottomLine: "You cannot recover what you cannot see. The first thing that changes is that the GHS 4,500 stops being invisible."
    },
    {
        label: "Scenario B",
        title: "A cosmetics chain across Accra and Kumasi",
        setup: "Two shops in Accra, one in Kumasi. Ordering happens when somebody notices a shelf looking empty, and each branch orders for itself.",
        cost: "Osu is holding forty units of a shade that has not moved in two months. Kumasi has been out of that same shade for three weeks and turning customers away. Head office orders more from the supplier, because nobody can see across the branches. Cash sits dead on one shelf while sales are lost on another.",
        shows: [
            "Stock levels in all three branches on one screen, side by side",
            "A transfer from Osu to Kumasi instead of a fresh supplier order",
            "Per-branch sales reporting, so you know which shop is actually carrying the chain",
            "Reorder suggestions built from each branch's own sales history"
        ],
        bottomLine: "The stock you need is often already inside your own business. You just cannot see it from where you are standing."
    }
];

type PricingPlan = {
    name: string;
    monthlyPrice: string; monthlyPeriod: string;
    yearlyPrice: string; yearlyPeriod: string;
    setupFee: string;
    description: string;
    features: string[];
    isPopular: boolean;
    buttonText: string;
    /* Exactly one of these. `selfServe` tiers build their own signup link from
       the tier name; anything else states where it goes. */
    selfServe?: boolean;
    href?: string;
    setupLabel?: string;
    setupNote?: string;
};

const defaultPricingPlans: PricingPlan[] = [
    {
        name: "Single Branch",
        monthlyPrice: "GHS 250", monthlyPeriod: "/mo",
        yearlyPrice: "GHS 2,750", yearlyPeriod: "/yr",
        setupFee: "GHS 1,000",
        description: "One shop, run properly. Know what sold, what is left, and what your staff did with it.",
        features: [
            "1 Store Location",
            "Up to 3 POS Terminals",
            "Real-time Inventory Tracking",
            "Accounting, Invoicing & Receivables",
            "Sales Dashboard & Top Sellers",
            "Standard Support"
        ],
        /* `selfServe` drives the signup link: the href is built from the tier
           name so the choice made here survives the jump to the app. Franchise
           is quoted by hand and sets its own href instead. */
        isPopular: false, buttonText: "Start Free Trial", selfServe: true
    },
    {
        name: "Multi-Branch",
        monthlyPrice: "GHS 600", monthlyPeriod: "/mo",
        yearlyPrice: "GHS 6,600", yearlyPeriod: "/yr",
        setupFee: "GHS 2,500",
        description: "For when “how is the other shop doing?” has become a daily question. Every branch on one screen.",
        features: [
            "Up to 5 Store Locations",
            "Unlimited POS Terminals",
            "Loss Prevention & Shrinkage Alerts",
            "Cross-Branch Stock Transfers",
            "Loyalty, Gift Cards & SMS Campaigns",
            "Priority Support"
        ],
        isPopular: true, buttonText: "Start Free Trial", selfServe: true
    },
    {
        name: "Franchise",
        monthlyPrice: "Custom", monthlyPeriod: "",
        yearlyPrice: "Custom", yearlyPeriod: "",
        setupFee: "Custom Quote",
        description: "Six locations or more, or a distribution business. We build the setup around how you actually operate.",
        features: [
            "Unlimited Locations",
            "Custom API Integrations",
            "Legacy Data Migration",
            "On-site Staff Training",
            "Dedicated Account Manager",
            "Custom SLA & 99.9% Uptime"
        ],
        isPopular: false, buttonText: "Talk to Sales", href: "#erp-contact",
        /* "+ Custom Quote one-time setup" reads as broken English, and the
           trial-conversion caveat is meaningless when the whole plan is
           quoted. Franchise gets its own wording. */
        setupLabel: "Setup quoted with your plan",
        setupNote: "Priced around your locations, migration and training needs."
    }
];

const featureCategories = [
    {
        name: "Platform Basics",
        features: [
            { name: "Max Store Locations", single: "1 Location", multi: "Up to 5 Locations", franchise: "Unlimited Locations" },
            { name: "Setup Fee", single: "GHS 1,000", multi: "GHS 2,500", franchise: "Custom Quote" },
            { name: "Support Level", single: "Standard Support", multi: "Priority Support", franchise: "Dedicated Account Mgr" }
        ]
    },
    {
        name: "Point of Sale (POS)",
        features: [
            { name: "Max POS Terminals", single: "Up to 3", multi: "Unlimited", franchise: "Unlimited" },
            { name: "Touch-Optimized Register", single: "Yes", multi: "Yes", franchise: "Yes" },
