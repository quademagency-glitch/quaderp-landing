        ]
    },
    {
        name: "CRM & Customer Loyalty",
        features: [
            { name: "Customer Profiles & History", single: "Yes", multi: "Yes", franchise: "Yes" },
            { name: "Loyalty Points & Rewards", single: "No", multi: "Yes", franchise: "Yes" },
