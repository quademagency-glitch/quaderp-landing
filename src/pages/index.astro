    <script>
        // Form AJAX submit
        const erpForm = document.getElementById('erpContactForm') as HTMLFormElement | null;
        const erpSubmitBtn = document.getElementById('erpSubmitBtn') as HTMLButtonElement | null;
        const erpFormResult = document.getElementById('erpFormResult');

        erpForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!erpSubmitBtn || !erpFormResult) return;

            erpSubmitBtn.disabled = true;
            erpSubmitBtn.textContent = 'Sending…';
            erpFormResult.className = 'erp-form-result';
            erpFormResult.textContent = '';

            try {
                const res = await fetch(erpForm.action, {
                    method: 'POST',
                    body: new FormData(erpForm),
                    headers: { 'Accept': 'application/json' }
                });

                if (res.ok) {
                    erpForm.reset();
                    erpFormResult.textContent = '✓ Request sent! We\'ll reach out within 24 hours.';
                    erpFormResult.className = 'erp-form-result erp-form-success';
                    erpSubmitBtn.textContent = 'Sent!';
                } else {
                    throw new Error('Server error');
                }
            } catch {
                erpFormResult.textContent = '✗ Something went wrong. Please try WhatsApp or email us directly.';
                erpFormResult.className = 'erp-form-result erp-form-error';
                erpSubmitBtn.disabled = false;
                erpSubmitBtn.textContent = 'Try Again';
            }
        });

        // Count-up animation for numeric stats
        const countUpEls = document.querySelectorAll('.stat-number:not(.erp-stat-text)');
        const countUpObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (!entry.isIntersecting) return;
                const el = entry.target as HTMLElement;
                const target = parseInt(el.dataset.target ?? '0', 10);
                const suffix = (el.textContent ?? '').replace(/\d+/g, '').trim();
                const duration = 1400;
                const start = performance.now();
                const tick = (now: number) => {
                    const progress = Math.min((now - start) / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    el.textContent = Math.floor(eased * target) + suffix;
                    if (progress < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
                countUpObserver.unobserve(el);
            });
        }, { threshold: 0.6 });

        countUpEls.forEach(el => countUpObserver.observe(el));

        // Pricing toggle
        const pricingToggle = document.getElementById('pricing-toggle');
        const labelMonthly = document.getElementById('label-monthly');
        const labelYearly = document.getElementById('label-yearly');
        const priceElements = document.querySelectorAll('.tier-price');

        if (pricingToggle) {
            pricingToggle.addEventListener('change', (e) => {
                const isYearly = e.target.checked;
                
                if (isYearly) {
                    labelMonthly.classList.remove('active');
                    labelYearly.classList.add('active');
                } else {
                    labelMonthly.classList.add('active');
                    labelYearly.classList.remove('active');
                }

                priceElements.forEach(el => {
                    const amountSpan = el.querySelector('.price-amount');
                    const periodSpan = el.querySelector('.erp-price-period');
                    
                    if (isYearly) {
                        amountSpan.textContent = el.dataset.yearlyPrice;
                        periodSpan.textContent = el.dataset.yearlyPeriod;
                    } else {
                        amountSpan.textContent = el.dataset.monthlyPrice;
                        periodSpan.textContent = el.dataset.monthlyPeriod;
                    }
                });
            });
        }
    </script>
</Layout>

