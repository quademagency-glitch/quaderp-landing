    <section class="process section-padding section-alt" id="erp-process">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <span class="erp-eyebrow">Getting started</span>
                <h2>Three Steps, and We Do the Heavy Lifting</h2>
                <p>Thirty days to make up your mind, at no cost and with nothing to cancel.</p>
