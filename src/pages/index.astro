                            Chat on WhatsApp
                        </a>
                        <p class="erp-contact-info-mail">Or email us at <a href="mailto:info@quaderp.app">info@quaderp.app</a></p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        // Hero parallax: the mockup lags the scroll slightly, so it reads as sitting
        // deeper than the copy. Purely decorative, so it stays off for reduced motion.
        const heroParallax = document.getElementById('heroParallax');
        const heroSection = document.getElementById('erp-hero');

        if (heroParallax && heroSection && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            let parallaxQueued = false;

            const updateHeroParallax = () => {
                parallaxQueued = false;
                // Cap at the hero's own height so the offset freezes once it's off screen.
                const scrolled = Math.min(window.scrollY, heroSection.offsetHeight);
                heroParallax.style.setProperty('--parallax-y', `${scrolled * 0.08}px`);
            };

            window.addEventListener('scroll', () => {
                if (parallaxQueued) return;
                parallaxQueued = true;
                requestAnimationFrame(updateHeroParallax);
            }, { passive: true });

            updateHeroParallax();
        }

        // Plan pre-selection from pricing card buttons
        document.querySelectorAll<HTMLElement>('[data-plan]').forEach(btn => {
            btn.addEventListener('click', () => {
                const planSelect = document.getElementById('erp-plan-select') as HTMLSelectElement | null;
                if (planSelect) planSelect.value = btn.dataset.plan ?? '';
            });
        });

        // Form AJAX submit
        const erpForm = document.getElementById('erpContactForm') as HTMLFormElement | null;
        const erpSubmitBtn = document.getElementById('erpSubmitBtn') as HTMLButtonElement | null;
        const erpFormResult = document.getElementById('erpFormResult');

        erpForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!erpSubmitBtn || !erpFormResult) return;

            erpSubmitBtn.disabled = true;
            erpSubmitBtn.innerHTML = '<span class="erp-btn-spinner"></span>Sending…';
            erpFormResult.className = 'erp-form-result';
            erpFormResult.textContent = '';

            const formData = new FormData(erpForm);

            // Give each notification a scannable subject: business + plan/type,
            // so the inbox list isn't a wall of identical subject lines.
            const bizName = (formData.get('business_name') || 'New lead').toString().trim();
            const planPick = (formData.get('plan_interest') || '').toString().trim();
            const bizType = (formData.get('business_type') || '').toString().trim();
            const subjectTag = planPick || bizType;
            // An unchecked box is absent from FormData entirely, which would
            // read downstream as "field not on the form" rather than "they
            // said no". Make the answer explicit either way.
            const wantsDemo = (document.getElementById('erp-wants-demo') as HTMLInputElement | null)?.checked ?? false;
            formData.set('wants_demo', wantsDemo ? 'Yes' : 'No');
            formData.set(
                '_subject',
                `New QuadERP Request: ${bizName}${subjectTag ? ` (${subjectTag})` : ''}${wantsDemo ? ' — wants demo' : ''}`,
            );

            try {
                const res = await fetch(erpForm.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'Accept': 'application/json' }
                });

                if (res.ok) {
                    const formView = document.getElementById('erpFormView');
                    const successCard = document.getElementById('erpSuccessCard');
                    const successLead = document.getElementById('erpSuccessLead');
                    if (successLead && wantsDemo) {
                        successLead.textContent = "We'll reach out within 24 hours to book your demo. In the meantime you can grab a slot yourself:";
                    }
                    if (formView) formView.hidden = true;
                    if (successCard) successCard.hidden = false;

                    // Best-effort: our Resend function sends the branded lead
                    // notification (to us) + the customer confirmation. Formspree
                    // stays on as the submission archive. Never blocks success.
                    fetch('/api/confirm', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(Object.fromEntries(formData.entries()))
                    }).catch(() => {});
                } else {
                    throw new Error('Server error');
                }
            } catch {
                erpFormResult.textContent = 'Something went wrong. Please try WhatsApp or email us directly.';
                erpFormResult.className = 'erp-form-result erp-form-error';
                erpSubmitBtn.disabled = false;
                erpSubmitBtn.textContent = 'Try Again';
            }
        });

        // Pricing toggle
        const pricingToggle = document.getElementById('pricing-toggle') as HTMLInputElement | null;
        const labelMonthly = document.getElementById('label-monthly');
        const labelYearly = document.getElementById('label-yearly');
        const priceElements = document.querySelectorAll<HTMLElement>('.tier-price');

        if (pricingToggle) {
            pricingToggle.addEventListener('change', () => {
                const isYearly = pricingToggle.checked;

                labelMonthly?.classList.toggle('active', !isYearly);
                labelYearly?.classList.toggle('active', isYearly);

                priceElements.forEach(el => {
                    const amountSpan = el.querySelector('.price-amount');
                    const periodSpan = el.querySelector('.erp-price-period');
                    if (amountSpan) amountSpan.textContent = isYearly ? (el.dataset.yearlyPrice ?? '') : (el.dataset.monthlyPrice ?? '');
                    if (periodSpan) periodSpan.textContent = isYearly ? (el.dataset.yearlyPeriod ?? '') : (el.dataset.monthlyPeriod ?? '');
                });
            });
        }

        // FAQ accordion: only one answer open at a time, so the list stays
        // scannable rather than turning into a wall of text.
        const faqItems = document.querySelectorAll<HTMLDetailsElement>('.erp-faq-item');
        faqItems.forEach(item => {
            item.addEventListener('toggle', () => {
                if (!item.open) return;
                faqItems.forEach(other => {
                    if (other !== item) other.open = false;
                });
            });
        });
    </script>
</Layout>

<style>
    /* Ensure the hidden attribute always wins over element display rules */
    [hidden] {
        display: none !important;
    }

    /* Form heading pair, previously three inline style attributes. */
    .erp-form-title {
        margin-bottom: 5px;
    }

    .erp-form-lead {
        color: var(--text-muted);
        font-size: 14.5px;
        margin: 0 0 26px;
    }

    .erp-compare-features {
        margin-top: 72px;
        background: var(--bg-glass);
        border: 1px solid var(--border-glass);
        border-radius: 18px;
        padding: 32px;
    }

    .compare-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        font-family: var(--font-heading);
        font-size: 19px;
        font-weight: 600;
        letter-spacing: -0.015em;
        color: var(--text-primary);
        cursor: pointer;
        transition: color var(--dur) var(--ease-inout);
    }

    .compare-title:hover {
        color: var(--accent);
    }

    .compare-title::-webkit-details-marker {
        display: none;
    }

    .erp-compare-details > summary {
        list-style: none;
    }

    .compare-chevron {
        flex-shrink: 0;
        transition: transform var(--dur) var(--ease-out);
        color: var(--accent);
    }

    .erp-compare-details[open] .compare-chevron {
        transform: rotate(180deg);
    }

    .erp-compare-details[open] .compare-title {
        margin-bottom: 26px;
        border-bottom: 1px solid var(--border-glass);
        padding-bottom: 18px;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .erp-feature-table {
        width: 100%;
        border-collapse: collapse;
        text-align: center;
        min-width: 800px;
    }

    .erp-feature-table th {
        font-family: var(--font-heading);
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--text-primary);
        padding: 16px 14px;
        border-bottom: 1px solid var(--border-glass-strong);
        background: var(--bg-input);
    }

    .erp-feature-table th:first-child {
        text-align: left;
        border-top-left-radius: 10px;
    }

    .erp-feature-table th:last-child {
        border-top-right-radius: 10px;
    }

    .tier-sub {
        display: block;
        margin-top: 3px;
        font-family: var(--font-body);
        font-size: 12.5px;
        font-weight: 500;
        letter-spacing: 0;
        color: var(--text-muted);
        font-variant-numeric: tabular-nums lining-nums;
    }

    .category-row td {
        background: var(--bg-glass-hover);
        text-align: left;
        font-family: var(--font-heading);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--accent-2);
        padding: 12px 18px;
        border-bottom: 1px solid var(--border-glass);
        border-top: 1px solid var(--border-glass);
    }

    .erp-feature-table td {
        padding: 13px 14px;
        border-bottom: 1px solid var(--border-glass);
        color: var(--text-color);
        font-size: 14.5px;
    }

    .erp-feature-table td.feature-name {
        text-align: left;
        color: var(--text-muted);
    }

    .erp-feature-table tbody tr:not(.category-row):hover td {
        background: var(--bg-glass);
    }

    .text-accent {
        color: var(--accent);
    }

    /* The "not included" cells. A dash at placeholder contrast is the point:
       it should read as absent without competing with the ticks. */
    .text-muted {
        color: var(--text-placeholder);
    }

    @media (max-width: 768px) {
        .erp-compare-features {
            padding: 22px 16px;
        }
    }

    .tier-setup-fee {
        display: inline-block;
        align-self: flex-start;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--accent);
        margin: -2px 0 8px;
        background: var(--accent-soft);
        border: 1px solid var(--accent-line);
        padding: 3px 11px;
        border-radius: 100px;
        font-variant-numeric: tabular-nums lining-nums;
    }

    /* The setup fee is the single biggest objection in the field, so the
       "only when you convert" caveat sits directly under the number rather
       than being buried in the FAQ. */
    .tier-setup-note {
        font-size: 12.5px;
        line-height: 1.5;
        color: var(--text-muted);
        margin: 0 0 16px;
    }

    /* Secondary path out of a pricing card for owners who won't self-serve.
       Deliberately a text link, so it never competes with the trial button. */
    .tier-alt-link {
        display: block;
        margin-top: 14px;
        text-align: center;
        font-size: 13px;
        color: var(--text-muted);
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: color var(--dur) var(--ease-inout);
    }

    .tier-alt-link:hover {
        color: var(--accent);
    }

    /* "I'd like a live demo" — a real checkbox kept in the accessibility tree
       (focusable, announced, keyboard-toggled) with the painted box drawn
       beside it, since the native control cannot be styled to match. */
    .erp-demo-toggle {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 16px;
        margin-bottom: 20px;
        border: 1px solid var(--border-glass-strong);
        border-radius: 12px;
        background: var(--bg-glass);
        cursor: pointer;
        transition: border-color var(--dur) var(--ease-inout), background-color var(--dur) var(--ease-inout);
    }

    .erp-demo-toggle:hover {
        background: var(--bg-glass-hover);
        border-color: var(--accent-line);
    }

    .erp-demo-toggle:has(input:checked) {
        background: var(--accent-soft);
        border-color: var(--accent-line);
    }

    .erp-demo-toggle input {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    .erp-demo-toggle-box {
        flex-shrink: 0;
        width: 20px;
        height: 20px;
        margin-top: 1px;
        border: 1.5px solid var(--border-glass-strong);
        border-radius: 6px;
        background: var(--bg-input);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent-contrast);
        transition: background-color var(--dur) var(--ease-inout), border-color var(--dur) var(--ease-inout);
    }

    .erp-demo-toggle-box svg {
        opacity: 0;
        transform: scale(0.7);
        transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
    }

    .erp-demo-toggle input:checked + .erp-demo-toggle-box {
        background: var(--accent-solid);
        border-color: var(--accent-solid);
    }

    .erp-demo-toggle input:checked + .erp-demo-toggle-box svg {
        opacity: 1;
        transform: scale(1);
    }

    /* The visually-hidden input still takes focus, so the ring has to be
       drawn on the box that stands in for it. */
    .erp-demo-toggle input:focus-visible + .erp-demo-toggle-box {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    .erp-demo-toggle-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
        line-height: 1.4;
    }

    .erp-demo-toggle-text strong {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .erp-demo-toggle-text small {
        font-size: 12.5px;
        color: var(--text-muted);
    }

    .erp-form-result {
        display: none;
        margin-top: 16px;
        padding: 14px 18px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        line-height: 1.5;
    }

    .erp-form-result:not(:empty) {
        display: block;
    }

    /* Status colours come off the --positive / --negative tokens, which are
       already defined per theme. The four [data-theme="light"] blocks that
       used to sit here existed only because these were hardcoded. */
    .erp-form-success {
        background: var(--positive-soft);
        border: 1px solid var(--positive-line);
        color: var(--positive);
    }

    .erp-form-error {
        background: var(--negative-soft);
        border: 1px solid var(--negative-line);
        color: var(--negative);
    }

    .form-optional {
        font-size: 12px;
        font-weight: 400;
        color: var(--text-placeholder);
    }

    /* Success card */
    .erp-success-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 48px 24px;
        gap: 12px;
    }

    .erp-success-icon {
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: var(--positive-soft);
        border: 1.5px solid var(--positive-line);
        color: var(--positive);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 8px;
        flex-shrink: 0;
    }

    .erp-success-card h3 {
        font-size: 23px;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .erp-success-card > p {
        color: var(--text-muted);
        margin: 0;
    }

    .erp-success-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: 100%;
        max-width: 360px;
        margin-top: 8px;
    }

    /* Submit button spinner. Drawn from currentColor so it stays correct if
       the button ever sits on a different fill. */
    .erp-btn-spinner {
        display: inline-block;
        width: 14px;
        height: 14px;
        border: 2px solid currentColor;
        border-top-color: transparent;
        opacity: 0.85;
        border-radius: 50%;
        animation: erp-spin 0.65s linear infinite;
        vertical-align: middle;
        margin-right: 9px;
    }

    @keyframes erp-spin {
        to { transform: rotate(360deg); }
    }
</style>
