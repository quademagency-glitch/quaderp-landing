            <div class="erp-showcase-row erp-showcase-reverse">
                <div class="erp-showcase-image animate-on-scroll slide-left">
                    <div class="erp-showcase-img-wrapper">
                        <img src="/images/quaderp-inventory.png" alt="QuadERP inventory screen listing products with stock levels and low-stock status" width="1800" height="1091" loading="lazy" decoding="async" />
