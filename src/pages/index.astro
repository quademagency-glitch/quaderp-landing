/* The four promises that answer "what am I risking?".
   Every one of these was already on the page, buried in the FAQ accordion.
   That is to say behind a click, below the pricing table, at exactly the
   moment the reader has decided the price is the problem. Stating them at the
   decision point is not a new claim; it is the same claim, in time to matter. */
const guarantees = [
    { title: "30 days, no card", body: "Nothing to cancel and nothing to charge back. If you walk away you were never billed." },
    { title: "Setup billed only if you stay", body: "The one-time setup fee falls due when the trial converts, not when it starts." },
    { title: "Your data leaves with you", body: "Ask within 30 days of cancelling and we export your products, sales, customers and ledger." },
    { title: "Support in your timezone", body: "WhatsApp us and you get a person here, usually the same day." }
];

const pricingFaqs = [
    {
        q: "Is the free trial really free?",
        a: "Yes. Thirty days, no card at signup, and nothing to cancel if you decide to walk away. We would rather you test it in your own shop than take our word for it."
    },
    {
        q: "What does the setup fee actually pay for?",
        a: "Our team loading your products, prices and opening stock, setting up your branches, and training your staff so they can work the till on day one. It is a one-time charge, and it only falls due when you move onto a paid plan after the trial."
    },
    {
        q: "Do I need to buy a POS machine or any special hardware?",
        a: "No. QuadERP runs in a browser on the phone, tablet or laptop you already have. If you want a barcode scanner later, our scanner app turns a phone into one."
    },
    {
        q: "Can I start on Single Branch and move up later?",
        a: "Yes. When you open a second shop we move you to Multi-Branch. You pay the difference in the monthly fee, plus a one-time top-up on setup, which is the difference between the two setup fees. So GHS 1,500 on top of the GHS 1,000 you already paid, not a fresh GHS 2,500."
    },
    {
        q: "What happens to my data if I stop paying?",
        a: "It stays yours. For 30 days after you cancel, ask us and we will export your products, sales, customers and ledger into files you keep. We do not hold your business records hostage to a subscription."
    },
    {
        q: "Can I take Mobile Money through it?",
        a: "QuadERP records the payment, it does not take it. Cash, card and Mobile Money are each recorded against the sale, so the day's takings break down by method when you close the till, but the customer still pays on your own MoMo number or bank terminal. One sale carries one method today, so someone paying half cash and half MoMo goes through as two sales."
    },
    {
        q: "I have more than five branches. What then?",
        a: "That is the Franchise plan. Tell us the shape of your business and we will quote for it, including migrating your data across from whatever you are running now."
    },
    {
        q: "Is paying yearly worth it?",
        a: "It is twelve months for the price of eleven. Same product, one less invoice to think about during the year."
    },
    {
        /* The competitor a shop owner in Accra actually weighs us against is
           not QuickBooks, it is a local POS sold as a one-time lifetime
           licence you host yourself. That pitch is aimed squarely at the
           monthly fee, and until now the site had no answer to it anywhere:
           "one-time" appeared six times on this page and every one of them
           was about the setup fee.

           Conceding that buying once can be cheaper is not a weakness here.
           It is true for a shop that has someone technical, and a reader who
           has already been told the honest version of Mobile Money and the
           accounting scope will notice if this is the one answer that
           oversells. Backups are deliberately not in this list: the backup
           script in the server repo is started by launchd on a particular
           machine, not by anything we could point at from a sales page. */
        q: "Why a monthly fee instead of buying it once?",
        a: "The fee is not for the software so much as for keeping it running: the hosting, the updates, and a person on WhatsApp in your own timezone who usually answers the same day. Software you buy once and host yourself can genuinely come out cheaper, and if you have someone who can keep a server running and restore it when it falls over, it may be the better buy. Most shops do not have that person, and the cost of not having them shows up as a day of not selling rather than as a line on an invoice. What we will not do is make leaving hard: thirty days free with no card, and your products, sales, customers and ledger exported to you if you go."
    }
];

/* ==========================================================================
   STRUCTURED DATA
   The page had none. These are the three things a search engine cannot infer
   reliably from prose: what the product is, what it costs, and what questions
   it answers. The FAQ block is built from the same `pricingFaqs` array the
   page renders, so the markup and the schema cannot disagree.
   ========================================================================== */
const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "QuadERP",
        applicationCategory: "BusinessApplication",
        applicationSubCategory: "Point of Sale, Inventory Management, Retail ERP",
        operatingSystem: "Web browser",
        url: SITE_URL,
        image: absUrl("/images/og-cover.jpg"),
        description:
            "Store management software for retail shops, pharmacies and multi-branch businesses in Ghana. Point of sale with Mobile Money, live stock across branches, loss prevention and receivables.",
        inLanguage: "en-GH",
        offers: defaultPricingPlans
            /* Franchise is quoted by hand, and a schema Offer with no price is
               worse than no Offer: it renders as a blank price in results. */
            .filter((plan) => plan.selfServe)
            .map((plan) => ({
                "@type": "Offer",
                name: plan.name,
                price: plan.monthlyPrice.replace(/[^0-9.]/g, ""),
                priceCurrency: "GHS",
                url: signupUrl(plan.name),
                availability: "https://schema.org/InStock",
                description: plan.description,
            })),
        featureList: defaultFeatures.map((f) => f.title),
        publisher: {
            "@type": "Organization",
            name: "Quadem Digital Enterprise",
            url: "https://quademdigital.com",
        },
    },
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "QuadERP",
        url: SITE_URL,
        logo: absUrl("/images/QuadERP_icon.svg"),
        parentOrganization: {
            "@type": "Organization",
            name: "Quadem Digital Enterprise",
            url: "https://quademdigital.com",
        },
        areaServed: { "@type": "Country", name: "Ghana" },
        contactPoint: {
            "@type": "ContactPoint",
            contactType: "sales",
            email: "info@quaderp.app",
            telephone: `+${whatsappNumber}`,
            availableLanguage: "English",
        },
        sameAs: [
            "https://www.instagram.com/quaderp.app/",
            "https://x.com/QuadERPApp",
            "https://web.facebook.com/QuadERP",
            "https://www.linkedin.com/showcase/quaderp",
        ],
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: pricingFaqs.map((faq) => ({
            "@type": "Question",
            name: faq.q,
            acceptedAnswer: { "@type": "Answer", text: faq.a },
        })),
    },
];
---

<Layout
    title="QuadERP | Store Management Software for Retail in Ghana"
    description="QuadERP helps Ghanaian shops track sales, manage stock across branches, catch staff theft, and know who owes them. Free for 30 days, no card needed."
    jsonLd={jsonLd}
>
    <!-- ===== HERO ===== -->
    <section class="erp-hero" id="erp-hero">
        <div class="erp-hero-bg"></div>
        <div class="container erp-hero-container">
            <div class="erp-hero-content">
                <span class="erp-badge hero-reveal">Built for shops across Ghana</span>
                {/* Two-tone rather than a gradient-clipped span: the set-up
                    clause sits back in the muted ink and the phrase that does
                    the work stays at full strength. */}
                <h1 class="erp-hero-title hero-reveal hero-delay-1">
                    <span class="hl-soft">Stop Losing Money to</span>
                    Theft and Stockouts
                </h1>
                <p class="erp-hero-subtitle hero-reveal hero-delay-2">
                    See what's selling, what's in stock, and what your staff are doing across every branch, right from your phone.
                </p>
                <div class="erp-hero-ctas hero-reveal hero-delay-3">
                    <a href={appHref({ cta: 'hero', lp: Astro.url.pathname })} class="btn btn-primary btn-pill erp-btn-lg" data-track="trial_start" data-track-where="hero">Start Your 30-Day Free Trial</a>
                    {/* Opens the sandbox. It used to scroll to the showcase
                        instead, so a button labelled "Try Live Demo" did not
                        try the live demo: it moved you down the page to hunt
                        for a second button that did. The screenshots are still
                        there for anyone who scrolls; this no longer makes the
                        people who already want the product go looking. */}
