---
/**
 * The last thing on the page.
 *
 * Every route through this page used to end on the contact form: eight fields
 * and a heading that asks you to request a setup. A reader who has scrolled
 * past that has said no to the biggest ask on the page, and then the page
 * simply stops. This gives them the two smallest asks instead, the ones that
 * cost nothing and need no salesperson, on the way out.
 *
 * No new claims. The starting price, the sandbox and the same-day WhatsApp
 * reply are all stated elsewhere on this page already. Until 8 October 2026
 * this offered a 30-day trial with no card; there is no trial now, which makes
 * the sandbox the half of this section that lets someone try before paying.
 */
import { DEMO_URL, appHref } from '../config/site';

interface Props {
    /** Built in index.astro, which already holds the number and the message. */
    whatsappLink: string;
    /** Astro.url.pathname from the page, so attribution records where from. */
    lp: string;
}

const { whatsappLink, lp } = Astro.props;
---

<section class="erp-closing section-padding section-alt" id="erp-closing">
    <div class="container">
        <div class="section-header animate-on-scroll slide-up">
            <span class="erp-eyebrow">Ready when you are</span>
            <h2>Get Started, or Just Look Around First</h2>
            <p>
                The sandbox takes no account at all, and it is the way to try QuadERP before you
                pay. When you are ready, GHS 2,000 covers the one-time setup fee and your first year
                with one branch, then it is GHS 1,000 a year. Nothing to install either way: it runs
                in the browser, on the phones and laptops your shop already has.
            </p>
        </div>

        <div class="erp-closing-ctas animate-on-scroll slide-up delay-100">
            {/* trial_start is a historical event name kept for the funnel's
                history; it now means "signup started". */}
            <a
                href={appHref({ cta: 'closing', lp })}
                class="btn btn-primary btn-pill erp-btn-lg"
                data-track="trial_start"
                data-track-where="closing"
            >
                Get Started
            </a>
            <a
                href={DEMO_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-ghost btn-pill erp-btn-lg"
                data-track="demo_open"
                data-track-where="closing"
            >
                Try Live Demo
            </a>
        </div>

        <p class="erp-closing-note animate-on-scroll slide-up delay-200">
            Still deciding? <a
                href={whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                data-track="whatsapp_click"
                data-track-where="closing">Ask us on WhatsApp</a
            >, we usually reply the same day.
        </p>
    </div>
</section>
