# Resend API key — used server-side by api/confirm.js to send the branded
# form-confirmation email to people who submit the contact form.
#
# 1. Create a key at https://resend.com/api-keys
# 2. Verify the quaderp.app domain in Resend (add the DNS records it shows)
#    so emails can be sent from info@quaderp.app.
# 3. Add this variable in Vercel > Project Settings > Environment Variables
#    (do NOT commit the real key — .env is gitignored).
RESEND_API_KEY=

# Where lead notifications are delivered. Optional — defaults to
# info@quaderp.app if not set.
LEAD_NOTIFICATION_EMAIL=
