# Resend API key, used server-side by api/confirm.js to send the branded
# form-confirmation email to people who submit the contact form.
#
# 1. Create a key at https://resend.com/api-keys
# 2. Verify the quaderp.app domain in Resend (add the DNS records it shows)
#    so emails can be sent from info@quaderp.app.
# 3. Add this variable in Vercel > Project Settings > Environment Variables
#    (do NOT commit the real key. .env is gitignored).
#
# Optional. Leaving it unset does not break the form: api/confirm.js logs the
# lead and still reports success, and Formspree keeps the archive either way.
RESEND_API_KEY=

# Where lead notifications are delivered. Optional, defaults to
# info@quaderp.app if not set.
LEAD_NOTIFICATION_EMAIL=

# Accepted as an alias for LEAD_NOTIFICATION_EMAIL (checked second). It is the
# name the ERP server uses for the same address, so a single value can be
# pasted into both deploys rather than remembering which one wants which name.
PLATFORM_ADMIN_EMAIL=

# GA4 measurement ID, looks like G-XXXXXXXXXX. This is the switch that turns
# conversion tracking on: the seven events in src/config/analytics.ts fire
# either way, but with this unset they queue in the browser and go nowhere.
#
# PUBLIC_ prefix is required. Astro only exposes variables to client code when
# they carry it, so naming this GA_ID would leave it undefined in the browser
# and the tracking would silently stay off.
#
# Set it in Vercel > Project Settings > Environment Variables. It is currently
# set for Production only, on purpose: preview deploys and the clicking you do
# while testing would otherwise land in the same reports as real visitors, on a
# property that sees a few dozen sessions a week and cannot absorb the noise.
# If you want preview traffic measured, give Preview a second property rather
# than the same ID.
PUBLIC_GA_ID=
